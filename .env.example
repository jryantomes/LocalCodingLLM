# Copy to .env and edit. setup.sh does this for you and fills in the two
# generated secrets, so run that first unless you want to do it by hand.
#
# .env holds a password. Keep it out of git - the .gitignore beside it
# already does that, but check before you commit anything from this folder.

# ---- Where things live on the array --------------------------------------

# Container config and, more to the point, the downloaded models. A 30B model
# is around 19GB, and you will want more than one.
APPDATA=/mnt/user/appdata

# The code the agent is allowed to touch. Make this a real share you keep
# projects in. Do not point it at /mnt/user - an agent with a whole array in
# its workspace is a bad afternoon waiting to happen.
PROJECTS_DIR=/mnt/user/projects

# nobody:users, the standard owner of an Unraid share.
PUID=99
PGID=100
TZ=Etc/UTC

# ---- Network -------------------------------------------------------------

# Which host address the ports bind to. 0.0.0.0 means every interface on the
# server, which on a normal Unraid box is your LAN. To pin it to one NIC, put
# that interface's IP here instead.
#
# This is LAN-only either way. Nothing about it survives you forwarding a port
# on your router, so do not forward one.
BIND_ADDR=0.0.0.0

OLLAMA_PORT=11434
OPENWEBUI_PORT=3000
CODESERVER_PORT=8443

# ---- GPU -----------------------------------------------------------------

# `all`, or a specific card's UUID from `nvidia-smi -L`. Pin it if the box
# also runs Plex transcoding or anything else that wants the GPU.
NVIDIA_VISIBLE_DEVICES=all

# ---- Model server tuning -------------------------------------------------

# Context window in tokens. 32768 is a sane coding default. The KV cache scales
# with this, so if models start spilling out of VRAM into system RAM - you will
# know, generation drops to a crawl - bring this down to 16384 before you
# reach for a smaller model.
OLLAMA_CONTEXT_LENGTH=32768

# How long a model stays on the card after you stop typing.
OLLAMA_KEEP_ALIVE=30m

# q8_0 roughly halves what the context costs in VRAM at a quality difference
# most people cannot pick out. Set f16 if you want the model's full precision
# and have the headroom.
OLLAMA_KV_CACHE_TYPE=q8_0

# Chat model and autocomplete model, both resident.
OLLAMA_MAX_LOADED_MODELS=2

# ---- Secrets -------------------------------------------------------------

# The code-server login. Compose will not start without it. Make it a real
# password: this unlocks an editor with a shell in it.
CODESERVER_PASSWORD=

# Signs Open WebUI session cookies. Any long random string; setup.sh generates
# one. Changing it later logs everyone out and nothing worse.
WEBUI_SECRET_KEY=

# Set false once you have created your own account, or your LAN can sign up.
ENABLE_SIGNUP=true

# Quote any value containing a space. Compose tolerates it either way, but
# setup.sh and pull-models.sh read this file with the shell, which does not.
WEBUI_NAME="Unraid LLM"

# ---- Image tags ----------------------------------------------------------

# Pinning these to a version rather than a rolling tag is the difference
# between a stack that keeps working and one that changes under you on a
# `docker compose pull`.
OLLAMA_TAG=latest
OPENWEBUI_TAG=main
CODESERVER_TAG=latest
